# Backend (copy to backend/.env)
DATABASE_URL="postgresql://hotel:hotel@localhost:5432/hotel_mvp?schema=public"
PORT=3001
FRONTEND_URL="http://localhost:5173"
NODE_ENV=development

# Frontend (copy to frontend/.env)
VITE_API_URL="http://localhost:3001"
# Use mock data layer instead of backend API (no server required)
# VITE_DATA_SOURCE=mock
# Optional: simulated network delay in ms when using mock (default 350)
# VITE_MOCK_LATENCY_MS=350
